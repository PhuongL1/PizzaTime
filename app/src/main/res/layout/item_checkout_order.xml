<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivOrderItemImage"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_customer_order_history_item_image"
        android:contentDescription="@string/customer_order_history_item_image_description"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_pizza_time" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOrderItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pt_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Margherita Verace" />

        <TextView
            android:id="@+id/tvOrderItemMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/pt_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="x1 · Large · Extra Basil" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvOrderItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/pt_gold"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="$24.00" />

</LinearLayout>
