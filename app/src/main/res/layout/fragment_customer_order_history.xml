<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.customer.orderhistory.CustomerOrderHistoryFragment">

    <include
        android:id="@+id/customerTopBar"
        layout="@layout/layout_customer_top_bar"
        android:layout_width="0dp"
        android:layout_height="66dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/customerBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/customerTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Order History" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Your late-night artisan chronicles." />

            <HorizontalScrollView
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="26dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAllOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_customer_order_history_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minWidth="104dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/customer_order_history_filter_all"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDelivered"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_customer_order_history_chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minWidth="104dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/customer_order_history_filter_delivered"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipCanceled"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_customer_order_history_chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minWidth="104dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/customer_order_history_filter_canceled"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/orderHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/rewardCard"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/bg_customer_order_history_reward_card"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/tvRewardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pt_cream"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Order #5 is near!" />

                <TextView
                    android:id="@+id/tvRewardDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/pt_cream"
                    android:textSize="14sp"
                    tools:text="Place one more order to unlock tier benefits." />

                <ProgressBar
                    android:id="@+id/rewardProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="18dp"
                    android:indeterminate="false"
                    android:max="5"
                    android:progress="4"
                    android:progressDrawable="@drawable/bg_customer_order_history_progress" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRewardCurrentOrders"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:textColor="@color/pt_cream"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="4 ORDERS" />

                    <TextView
                        android:id="@+id/tvRewardTargetOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:textColor="@color/pt_cream"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="5 ORDERS" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="52dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/customerBottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
