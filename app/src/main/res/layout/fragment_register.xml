<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/registerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- TOP BAR -->
        <FrameLayout
            android:id="@+id/registerTopBar"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_login_back_button"
                android:clickable="true"
                android:contentDescription="@string/common_back_content_description"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvRegisterBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/pt_gold"
                android:textSize="40sp" />

        </FrameLayout>

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:text="@string/register_title"
            android:textColor="@color/pt_text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegisterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="5dp"
            android:text="@string/register_subtitle"
            android:textColor="@color/pt_text_secondary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- FORM -->
        <TextView
            android:id="@+id/tvLabelFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/register_label_full_name"
            android:textColor="@color/pt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/register_hint_full_name"
            android:importantForAutofill="yes"
            android:inputType="textPersonName"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="@color/pt_text_primary"
            android:textColorHint="@color/pt_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLabelEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/register_label_email"
            android:textColor="@color/pt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/register_hint_email"
            android:importantForAutofill="yes"
            android:inputType="textEmailAddress"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="@color/pt_text_primary"
            android:textColorHint="@color/pt_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLabelPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/register_label_phone"
            android:textColor="@color/pt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="phone"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/register_hint_phone"
            android:importantForAutofill="yes"
            android:inputType="phone"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="@color/pt_text_primary"
            android:textColorHint="@color/pt_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLabelPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/register_label_password"
            android:textColor="@color/pt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/register_hint_password"
            android:importantForAutofill="yes"
            android:inputType="textPassword"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="@color/pt_text_primary"
            android:textColorHint="@color/pt_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLabelConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/register_label_confirm"
            android:textColor="@color/pt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/register_hint_confirm"
            android:importantForAutofill="yes"
            android:inputType="textPassword"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:singleLine="true"
            android:textColor="@color/pt_text_primary"
            android:textColorHint="@color/pt_text_muted"
            android:textSize="16sp" />

        <!-- TERMS -->
        <LinearLayout
            android:id="@+id/termsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/checkboxTerms"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_register_checkbox" />

            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/pt_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="@string/register_terms_prefix" />

        </LinearLayout>

        <!-- BUTTON -->
        <TextView
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary_gold"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/register_create_account"
            android:textColor="@color/pt_text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- SOCIAL DIVIDER -->
        <LinearLayout
            android:id="@+id/socialDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/bg_register_divider" />

            <TextView
                android:id="@+id/tvOrJoinWith"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:text="@string/register_or_join_with"
                android:textColor="@color/pt_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/bg_register_divider" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/socialButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGoogle"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_social_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/register_google"
                android:textColor="@color/pt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFacebook"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_social_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/register_facebook"
                android:textColor="@color/pt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- EXPERIENCE -->
        <TextView
            android:id="@+id/tvExperienceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="@string/register_experience_title"
            android:textColor="@color/pt_gold"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/experienceGrid"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgExperienceOven"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_register_experience_card"
                android:contentDescription="@string/register_image_oven_content_description"
                android:scaleType="centerCrop"
                android:src="@drawable/img_welcome_hero" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgExperienceKitchen"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_register_experience_card"
                    android:contentDescription="@string/register_image_kitchen_content_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_welcome_hero" />

                <LinearLayout
                    android:id="@+id/cardArtisanQuality"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_register_experience_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvQualityStar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★"
                        android:textColor="@color/pt_gold"
                        android:textSize="42sp" />

                    <TextView
                        android:id="@+id/tvQualityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.08"
                        android:text="@string/register_artisan_quality"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>