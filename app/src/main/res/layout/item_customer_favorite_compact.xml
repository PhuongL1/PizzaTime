<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="164dp"
    android:background="@drawable/bg_customer_favorites_card"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="166dp"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivFavoriteImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/customer_favorites_item_image_description"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_pizza_time" />

        <TextView
            android:id="@+id/tvImagePlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pt_surface_soft"
            android:gravity="center"
            android:text="@string/customer_favorites_image_placeholder"
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="28sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/btnHeart"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/customer_favorites_heart"
            android:textColor="@color/pt_copper"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/tvFavoriteName"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Artisan Margherita" />

        <TextView
            android:id="@+id/tvFavoritePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pt_copper"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="$18.00" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="104dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_customer_favorites_compact_add_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/customer_favorites_add"
            android:textColor="@color/pt_text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>