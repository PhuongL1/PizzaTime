<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customerHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="96dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/homeTopBar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_home_header"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgHomeLocation"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/welcome_location_label"
                    android:src="@drawable/ic_location" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeliveringTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.10"
                        android:text="@string/home_delivering_to"
                        android:textColor="@color/pt_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_location"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnHomeAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/home_avatar_content_description"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_avatar" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvGreetingOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/home_greeting_line_1"
                android:textColor="@color/pt_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGreetingTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="@string/home_greeting_line_2"
                android:textColor="@color/pt_gold"
                android:textSize="28sp"
                android:textStyle="italic|bold" />

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_input_round_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/home_search_hint"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/tvSearchHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/home_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/pt_text_primary"
                    android:textColorHint="@color/pt_text_muted"
                    android:textSize="14sp"
                    tools:ignore="Autofill" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/serviceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:baselineAligned="false" android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_circle_dark_icon">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_service_delivery"
                            android:src="@drawable/ic_delivery" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.10"
                        android:text="@string/home_service_delivery"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_circle_dark_icon">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_service_collect"
                            android:src="@drawable/ic_collect" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.10"
                        android:text="@string/home_service_collect"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_circle_dark_icon">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_service_dine_in"
                            android:src="@drawable/ic_dine_in" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.10"
                        android:text="@string/home_service_dine_in"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:id="@+id/promoCard"
                android:layout_width="match_parent"
                android:layout_height="176dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_home_promo_card">

                <ImageView
                    android:id="@+id/imgPromoPizza"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.88"
                    android:contentDescription="@string/home_promo_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_welcome_hero" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_scrim_bottom" />

                <LinearLayout
                    android:layout_width="178dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.10"
                        android:text="@string/home_promo_label"
                        android:textColor="@color/pt_gold"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPromoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="serif"
                        android:includeFontPadding="false"
                        android:text="@string/home_promo_title"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/btnPromoAction"
                        android:layout_width="132dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_primary_light"
                        android:gravity="center"
                        android:letterSpacing="0.10"
                        android:text="@string/home_promo_button"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <HorizontalScrollView
                android:id="@+id/categoryScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categoryRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="82dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_selected_gold"
                        android:gravity="center"
                        android:letterSpacing="0.10"
                        android:text="@string/home_category_all"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipPizza"
                        android:layout_width="82dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip_unselected_dark"
                        android:gravity="center"
                        android:letterSpacing="0.10"
                        android:text="@string/home_category_pizza"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipCombo"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip_unselected_dark"
                        android:gravity="center"
                        android:letterSpacing="0.10"
                        android:text="@string/home_category_combo"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDrinks"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip_unselected_dark"
                        android:gravity="center"
                        android:letterSpacing="0.10"
                        android:text="@string/home_category_drinks"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDessert"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_chip_unselected_dark"
                        android:gravity="center"
                        android:letterSpacing="0.10"
                        android:text="@string/home_category_dessert"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="@string/home_best_sellers"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/home_see_all"
                    android:textColor="@color/pt_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/bestSellerScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bestSellerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="@string/home_chef_selection"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/home_see_all"
                    android:textColor="@color/pt_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/chefSelectionScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chefSelectionContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="72dp" />

        </LinearLayout>


    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp" />

</FrameLayout>
