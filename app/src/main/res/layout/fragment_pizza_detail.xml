<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pizzaDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark">

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="170dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/heroSection"
                android:layout_width="match_parent"
                android:layout_height="560dp">

                <ImageView
                    android:id="@+id/imgPizzaHero"
                    android:layout_width="match_parent"
                    android:layout_height="430dp"
                    android:contentDescription="@string/menu_open_pizza"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_welcome_hero" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_image_scrim_bottom" />

                <LinearLayout
                    android:id="@+id/detailTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/detail_back_content_description"
                        android:src="@drawable/ic_back" />

                    <TextView
                        android:id="@+id/tvDetailBrand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.12"
                        android:text="@string/detail_brand"
                        android:textColor="@color/pt_gold"
                        android:textSize="30sp" />

                    <FrameLayout
                        android:id="@+id/btnCart"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/detail_cart_content_description"
                            android:src="@drawable/ic_bag" />

                        <TextView
                            android:id="@+id/tvCartBadge"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_badge_red"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/pt_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/infoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/bg_detail_info_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPizzaName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/pt_text_primary"
                            android:textSize="36sp" />

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="76dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_rating_pill"
                            android:gravity="center"
                            android:textColor="@color/pt_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPizzaDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingExtra="8dp"
                        android:textColor="@color/pt_text_secondary"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/detail_info_time"
                            android:src="@drawable/ic_clock" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/pt_text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="28dp"
                            android:contentDescription="@string/detail_info_kcal"
                            android:src="@drawable/ic_fire" />

                        <TextView
                            android:id="@+id/tvKcal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/pt_text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/optionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/detail_select_size"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/sizeRow"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSizeSmall"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_size_option_unselected"
                        android:gravity="center"
                        android:text="@string/detail_size_small_display"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSizeMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_size_option_selected"
                        android:gravity="center"
                        android:text="@string/detail_size_medium_display"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSizeLarge"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_size_option_unselected"
                        android:gravity="center"
                        android:text="@string/detail_size_large_display"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/detail_crust_style"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/crustRow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCrustClassic"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_crust_unselected"
                        android:gravity="center"
                        android:text="@string/detail_crust_classic"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCrustThin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1.35"
                        android:background="@drawable/bg_crust_selected"
                        android:gravity="center"
                        android:text="@string/detail_crust_thin_charcoal"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCrustThick"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_crust_unselected"
                        android:gravity="center"
                        android:text="@string/detail_crust_thick_pan"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toppingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/detail_extra_toppings"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCustomizeToppings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.10"
                        android:text="@string/detail_customize"
                        android:textColor="@color/pt_gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <GridLayout
                    android:id="@+id/toppingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:columnCount="2" />

                <LinearLayout
                    android:id="@+id/quantityRow"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvQuantityTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/detail_quantity"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/quantityControl"
                        android:layout_width="236dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_quantity_pill"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMinus"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="−"
                            android:textColor="@color/pt_text_primary"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/tvQuantity"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/pt_text_primary"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/btnPlus"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/pt_text_primary"
                            android:textSize="28sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="90dp" />


        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/detailBottomBar"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_detail_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout
            android:id="@+id/btnFavorite"
            android:layout_width="78dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_outline_gold"
            android:clickable="true"
            android:contentDescription="@string/detail_favorite_content_description"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgFavorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/detail_favorite_content_description"
                android:src="@drawable/ic_empty_heart" />

        </FrameLayout>

        <TextView
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_light"
            android:gravity="center"
            android:textColor="@color/pt_text_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="@string/detail_add_to_cart" />

    </LinearLayout>

</FrameLayout>
