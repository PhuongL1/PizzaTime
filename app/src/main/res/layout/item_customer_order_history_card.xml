<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_customer_order_history_card"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="26dp"
    android:paddingEnd="28dp"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textColor="@color/pt_copper"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="OCT 24, 2023 · 11:42 PM" />

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Order #PT-8821" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="116dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_customer_order_history_status_delivered"
            android:gravity="center"
            android:textColor="@color/pt_basil_green"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="DELIVERED" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_customer_order_history_item_image">

            <ImageView
                android:id="@+id/ivOrderImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/customer_order_history_item_image_description"
                android:scaleType="centerCrop"
                tools:src="@drawable/img_pizza_time" />

            <TextView
                android:id="@+id/tvOrderImagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/customer_order_history_item_placeholder"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="24sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvItemSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="18sp"
            tools:text="1x Truffle Ember Neapolitan&#10;2x Peroni Nastro Azzurro" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pt_copper"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="$42.00" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="@color/pt_stroke_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSecondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_customer_order_history_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:textColor="@color/pt_copper"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="VIEW DETAILS" />

        <TextView
            android:id="@+id/btnPrimary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_customer_order_history_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:textColor="@color/pt_text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="REORDER" />
    </LinearLayout>
</LinearLayout>