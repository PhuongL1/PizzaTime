<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kitchenBoardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:orientation="vertical">

    <include
        android:id="@+id/headerKitchen"
        layout="@layout/layout_staff_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/kitchenFilterContainer"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/chipWaiting"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected_gold"
            android:gravity="center"
            android:text="@string/kitchen_chip_waiting"
            android:textColor="@color/pt_text_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chipPreparing"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected_dark"
            android:gravity="center"
            android:text="@string/kitchen_chip_preparing"
            android:textColor="@color/pt_text_primary"
            android:textSize="16sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKitchenOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp" />

    <include
        android:id="@+id/staffBottomNav"
        layout="@layout/layout_staff_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="88dp" />

</LinearLayout>
