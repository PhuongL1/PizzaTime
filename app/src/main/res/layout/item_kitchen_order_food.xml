<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kitchenFoodRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFoodName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EDE2DA"
            android:textSize="17sp"
            tools:text="1x Truffle Noir" />

        <TextView
            android:id="@+id/tvFoodSize"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_kitchen_size_badge"
            android:gravity="center"
            android:minWidth="50dp"
            android:paddingHorizontal="10dp"
            android:textColor="#E6D4C8"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="LARGE" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/foodDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <View
            android:layout_width="2dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:background="#B98A64" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodModifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6D4C8"
                android:textSize="16sp"
                tools:text="⊘  NO ONIONS" />

            <TextView
                android:id="@+id/tvFoodCrust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#D8C8BC"
                android:textSize="16sp"
                android:textStyle="italic"
                tools:text="Thin Crust Artisan" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/viewFoodDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="#342D29" />

</LinearLayout>