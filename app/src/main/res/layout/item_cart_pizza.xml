<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartItemRoot"
    android:layout_width="match_parent"
    android:layout_height="142dp">

    <ImageView
        android:id="@+id/imgPizza"
        android:layout_width="150dp"
        android:layout_height="142dp"
        android:contentDescription="@string/menu_open_pizza"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_welcome_hero" />

    <FrameLayout
        android:id="@+id/cartItemContent"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:layout_marginStart="120dp"
        android:background="@drawable/bg_cart_item_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="16dp"
            android:paddingEnd="58dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvPizzaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="#151312"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Truffle Noir" />

            <TextView
                android:id="@+id/tvPizzaPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#D1843D"
                android:textSize="18sp"
                tools:text="$28.00" />

            <LinearLayout
                android:id="@+id/quantityControl"
                android:layout_width="144dp"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_quantity_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMinus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="@string/cart_decrease_quantity"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="24sp"
                    tools:text="1" />

                <TextView
                    android:id="@+id/btnPlus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="@string/cart_increase_quantity"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="26sp" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:clickable="true"
            android:contentDescription="@string/cart_remove_item"
            android:focusable="true"
            android:src="@drawable/ic_trash" />

    </FrameLayout>

</FrameLayout>