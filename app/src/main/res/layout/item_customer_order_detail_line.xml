<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_customer_order_detail_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_customer_order_detail_item_image">

        <ImageView
            android:id="@+id/ivItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/customer_order_detail_item_image_description"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_pizza_time" />

        <TextView
            android:id="@+id/tvItemPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/customer_order_detail_item_placeholder"
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1x Truffle Forest Pizza" />

        <TextView
            android:id="@+id/tvItemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="13sp"
            tools:text="Large · Thin Crust · Extra Truffle Oil" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/pt_copper"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="$28.00" />
</LinearLayout>
