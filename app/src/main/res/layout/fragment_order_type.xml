<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.customer.order.OrderTypeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:background="@color/pt_surface_dark"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/locationGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivLocation"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/order_type_location_icon_description"
                android:src="@drawable/ic_location"
                app:tint="@color/pt_copper" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/order_type_location"
                android:textColor="@color/pt_copper"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/pt_copper"
            android:textSize="26sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivVenueAvatar"
            app:layout_constraintStart_toEndOf="@id/locationGroup"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivVenueAvatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/order_type_avatar_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PizzaTime.Circle"
            app:strokeColor="@color/pt_copper"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="72dp"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingExtra="4dp"
                android:text="@string/order_type_title"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="6dp"
                android:text="@string/order_type_subtitle"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="23sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/optionDelivery"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="58dp"
                android:background="@drawable/bg_order_type_option_selected"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="44dp"
                android:paddingEnd="28dp">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_order_type_icon_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/order_type_delivery_icon_description"
                        android:src="@drawable/ic_delivery"
                        app:tint="@color/pt_text_primary_dark_bg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/order_type_delivery_title"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/order_type_delivery_description"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/optionSelfCollect"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_order_type_option"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="44dp"
                android:paddingEnd="28dp">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_order_type_icon_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/order_type_self_collect_icon_description"
                        android:src="@drawable/ic_order_self_collect"
                        app:tint="@color/pt_text_primary_dark_bg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/order_type_self_collect_title"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/order_type_self_collect_description"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/optionDineIn"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_order_type_option"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="44dp"
                android:paddingEnd="28dp">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_order_type_icon_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/order_type_dine_in_icon_description"
                        android:src="@drawable/ic_dine_in"
                        app:tint="@color/pt_text_primary_dark_bg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/order_type_dine_in_title"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/order_type_dine_in_description"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="58dp"
                android:background="@drawable/bg_order_type_hero_card"
                android:clipToOutline="true"
                android:padding="1dp">

                <ImageView
                    android:id="@+id/ivHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/order_type_hero_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_pizza_time" />

                <View
                    android:id="@+id/heroOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_order_type_hero_overlay" />

                <TextView
                    android:id="@+id/tvPremiumBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="28dp"
                    android:layout_marginBottom="26dp"
                    android:background="@drawable/bg_order_type_badge"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="@string/order_type_premium_badge"
                    android:textColor="@color/pt_copper"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </FrameLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="118dp"
        android:background="@color/pt_surface_dark"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/bg_order_type_continue_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/order_type_continue"
            android:textColor="@color/pt_text_dark"
            android:textSize="25sp"
            android:textStyle="bold" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>