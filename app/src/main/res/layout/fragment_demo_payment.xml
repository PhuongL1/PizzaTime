<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pt_background"
        tools:context=".feature.customer.payment.DemoPaymentFragment">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_top_bar_dark"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/detail_back_content_description"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/pt_gold"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Demo QR Payment" />

        <Space
            android:layout_width="34dp"
            android:layout_height="34dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pt_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Waiting for payment" />

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                tools:text="Scan this QR code with another device, or open the payment page." />

            <ProgressBar
                android:id="@+id/progressSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_customer_order_detail_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvOrderLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Order" />

                <TextView
                    android:id="@+id/tvOrderValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Order #de-3001" />

                <TextView
                    android:id="@+id/tvAmountLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Amount" />

                <TextView
                    android:id="@+id/tvAmountValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/pt_gold"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="123,000 VND" />

                <TextView
                    android:id="@+id/tvReferenceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Reference" />

                <TextView
                    android:id="@+id/tvReferenceValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="16sp"
                    tools:text="PTABCDEFG12345" />

                <TextView
                    android:id="@+id/tvExpirationLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Expiration" />

                <TextView
                    android:id="@+id/tvExpirationValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="16sp"
                    tools:text="Payment session expires in 15m" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_customer_order_detail_card"
                android:contentDescription="@string/demo_payment_qr_content_description"
                android:padding="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQrUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/demo_payment_qr_unavailable"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="15sp"
                tools:text="Scan this QR code with another device, or open the payment page." />

            <TextView
                android:id="@+id/tvDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/pt_copper"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="For testing purposes only.&#10;No real money will be transferred." />

            <TextView
                android:id="@+id/btnOpenPaymentPage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary_gold"
                android:gravity="center"
                android:text="@string/demo_payment_open_page"
                android:textColor="@color/pt_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRefreshPaymentStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_order_detail_support_button"
                android:gravity="center"
                android:text="@string/demo_payment_refresh_status"
                android:textColor="@color/pt_copper"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCreateNewPayment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_order_detail_reorder_button"
                android:gravity="center"
                android:text="@string/demo_payment_create_new"
                android:textColor="@color/pt_text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnBackToOrders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_customer_order_detail_support_button"
                android:gravity="center"
                android:text="@string/demo_payment_back_to_orders"
                android:textColor="@color/pt_copper"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
