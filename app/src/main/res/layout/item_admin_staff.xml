<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootStaffCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_admin_staff_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/layoutStaffHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_admin_staff_avatar"
            android:contentDescription="@string/staff_avatar"
            android:padding="8dp"
            android:src="@drawable/img_avatar" />

        <LinearLayout
            android:id="@+id/layoutStaffInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pt_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Marco Rossi" />

            <TextView
                android:id="@+id/tvStaffRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pt_gold_light"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="🍴 KITCHEN" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_staff_status_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/pt_gold_light"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="ACTIVE" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/pt_stroke_dark" />

    <LinearLayout
        android:id="@+id/layoutStaffActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStaffNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/pt_text_secondary"
            android:textSize="15sp"
            tools:text="Joined Mar 2023" />

        <ImageButton
            android:id="@+id/btnEditStaff"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/edit"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btnToggleStaffStatus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/change_staff_status"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_active_staff" />
    </LinearLayout>

</LinearLayout>