<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pizzaFlowBottomNavRoot"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="@drawable/bg_bottom_nav"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/navMenu"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:background="@drawable/bg_bottom_nav_item_selected"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/home_nav_menu"
        android:textColor="@color/pt_text_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navOrders"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/home_nav_orders"
        android:textColor="@color/pt_text_secondary_dark_bg"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navLoyalty"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/home_nav_loyalty"
        android:textColor="@color/pt_text_secondary_dark_bg"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/home_nav_profile"
        android:textColor="@color/pt_text_secondary_dark_bg"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
