<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trackingStepRoot"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/topLine"
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@color/pt_copper" />

        <View
            android:id="@+id/bottomLine"
            android:layout_width="2dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@color/pt_copper" />

        <FrameLayout
            android:id="@+id/statusCircle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_timeline_pending">

            <TextView
                android:id="@+id/tvStatusIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/pt_text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

        </FrameLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/pt_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="@color/pt_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
