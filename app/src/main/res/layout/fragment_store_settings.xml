<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/storeSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/storeSettingsTopBar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/bg_top_bar_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/common_back_arrow"
            android:textColor="@color/pt_gold_light"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="@string/store_settings_title"
            android:textColor="@color/pt_gold_light"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/store_settings_subtitle"
                android:textColor="@color/pt_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_store_name"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtStoreName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:hint="@string/store_settings_store_name_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_pickup_address"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPickupAddress"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:gravity="top|start"
                android:hint="@string/store_settings_pickup_address_hint"
                android:inputType="textMultiLine|textPostalAddress"
                android:padding="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPickupCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/location_coordinates_missing"
                android:textColor="@color/pt_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnPickPickupLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_payment_unselected"
                android:gravity="center"
                android:text="@string/store_settings_pick_on_map"
                android:textColor="@color/pt_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_store_phone"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtStorePhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:hint="@string/store_settings_store_phone_hint"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_opening_hours"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtOpeningHours"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:hint="@string/store_settings_opening_hours_hint"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_base_delivery_fee"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBaseDeliveryFee"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:hint="@string/store_settings_base_delivery_fee_hint"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_delivery_fee_per_km"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDeliveryFeePerKm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:hint="@string/store_settings_delivery_fee_per_km_hint"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="@string/store_settings_free_delivery_min_subtotal"
                android:textColor="@color/pt_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtFreeDeliveryMinSubtotal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_order_note"
                android:hint="@string/store_settings_free_delivery_min_subtotal_hint"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="@color/pt_text_primary"
                android:textColorHint="@color/pt_text_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_checkout_section_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/store_settings_accepting_orders"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switchAcceptingOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:checked="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnSaveStoreSettings"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_button_primary_gold"
                android:gravity="center"
                android:text="@string/store_settings_save"
                android:textColor="@color/pt_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
