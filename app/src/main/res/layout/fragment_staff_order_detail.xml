<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.staff.detail.StaffOrderDetailFragment">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_staff_order_detail_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/staff_order_detail_back_content_description"
            android:padding="8dp"
            android:src="@drawable/ic_menu" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Order #MT-8291" />

            <TextView
                android:id="@+id/tvReceivedAgo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="12sp"
                tools:text="Received 8 min ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_staff_order_detail_status_badge"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/pt_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="CONFIRMED" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="138dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/staff_order_detail_customer_details"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_staff_order_detail_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCustomerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_order_detail_customer_name_preview"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPickupInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="16sp"
                        app:drawableStartCompat="@drawable/ic_location_pin"
                        app:drawableTint="@color/pt_text_secondary_dark_bg"
                        tools:text="Pickup: PizzaTime, 123 Nguyen Trai, Ha Noi, 0900000000" />

                    <TextView
                        android:id="@+id/tvCustomerAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/staff_order_detail_customer_address_preview"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="16sp"
                        app:drawableStartCompat="@drawable/ic_location_pin"
                        app:drawableTint="@color/pt_text_secondary_dark_bg" />

                    <TextView
                        android:id="@+id/tvEstimatedDelivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/staff_order_detail_estimated_delivery_preview"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="16sp"
                        app:drawableStartCompat="@drawable/ic_clock"
                        app:drawableTint="@color/pt_text_secondary_dark_bg" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCallCustomer"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/bg_staff_order_detail_timeline_pending"
                    android:contentDescription="@string/staff_order_detail_call_customer_content_description"
                    android:padding="18dp"
                    android:src="@drawable/ic_customer_account_phone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:text="@string/staff_order_detail_order_items"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemsTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_order_detail_items_total_preview"
                    android:textColor="@color/pt_copper"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardMainItem"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_staff_order_detail_card"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPizza"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/staff_order_detail_item_image_content_description"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_pizza_time" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvItemName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/pt_text_primary_dark_bg"
                            android:textSize="20sp"
                            tools:text="Truffle &amp; Forest Fungi" />

                        <TextView
                            android:id="@+id/tvItemPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_order_detail_item_price_preview"
                            android:textColor="@color/pt_copper"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCrust"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="15sp"
                        android:textStyle="italic"
                        tools:text="No onions, extra parmesan" />

                    <TextView
                        android:id="@+id/tvSize"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_staff_order_detail_qty_badge"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="QTY: 1" />

                    <LinearLayout
                        android:id="@+id/containerToppings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAllergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_staff_order_detail_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAllergyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pt_copper"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="ALLERGY WARNING" />

                <TextView
                    android:id="@+id/tvAllergyMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="15sp"
                    tools:text="No peanuts." />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:letterSpacing="0.12"
                android:text="@string/staff_order_detail_payment"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardPayment"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_staff_order_detail_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/staff_order_detail_payment_content_description"
                    android:src="@drawable/ic_payment_wallet" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_order_detail_payment_method_preview"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvPaymentSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/staff_order_detail_payment_summary_preview"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.12"
                android:text="@string/staff_order_detail_delivery_note"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_staff_order_detail_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tvCustomerRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    tools:text="Gate code is 1234. Please leave at the lobby desk." />

                <LinearLayout
                    android:id="@+id/containerTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:letterSpacing="0.12"
                android:text="@string/staff_order_detail_order_timeline"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/timelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTimelinePlaced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_order_detail_timeline_order_placed"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimelineConfirmed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/staff_order_detail_timeline_confirmed"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimelinePreparing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/staff_order_detail_timeline_preparing"
                    android:textColor="@color/pt_copper"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimelineReady"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/staff_order_detail_timeline_ready_for_shipper"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCancelOrder"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="54dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/bg_customer_account_logout_card"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/staff_order_detail_cancel_order"
                android:textColor="@color/pt_danger_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="116dp"
        android:background="@drawable/bg_staff_order_detail_bottom_action_bar"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnDelay10"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="0.42"
            android:background="@drawable/bg_staff_order_detail_delay_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/staff_order_detail_delay_10m"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnAssignShipper"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:layout_weight="0.58"
            android:background="@drawable/bg_staff_order_detail_assign_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/staff_order_detail_assign_shipper"
            android:textColor="@color/pt_text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
