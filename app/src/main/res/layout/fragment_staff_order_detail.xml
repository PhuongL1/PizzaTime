<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/staffOrderDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerStaff"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_top_bar_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/staff_menu_content_description"
            android:padding="5dp"
            android:src="@drawable/ic_menu" />

        <TextView
            android:id="@+id/tvStaffTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="Midnight Artisan"
            android:textColor="#F2A96B"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStaffAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="@string/staff_avatar_initial"
            android:textColor="#F2A96B"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Order header section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- LIVE ORDER / RECEIVED row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLiveOrder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="@string/staff_order_detail_live_order"
                        android:textColor="#CF843F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceivedAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:textColor="#A08070"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Order ID -->
                <TextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="serif"
                    android:textColor="#F5EDE4"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <!-- Status row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_gold_soft"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:textColor="#CF843F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Card: Current Item -->
            <LinearLayout
                android:id="@+id/cardCurrentItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_product_card_light"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/staff_order_detail_current_item"
                    android:textColor="#8A6A52"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="serif"
                    android:textColor="#1E1209"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Size / Crust row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/staff_order_detail_size"
                            android:textColor="#8A6A52"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#2E1A0E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/staff_order_detail_crust"
                            android:textColor="#8A6A52"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCrust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#2E1A0E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#D4B89A" />

                <!-- Toppings label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/staff_order_detail_toppings_build"
                    android:textColor="#8A6A52"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Toppings list (populated dynamically) -->
                <LinearLayout
                    android:id="@+id/containerToppings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Pizza image -->
                <ImageView
                    android:id="@+id/imgPizza"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="18dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

            </LinearLayout>

            <!-- Allergy card -->
            <LinearLayout
                android:id="@+id/cardAllergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_allergy_alert"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/staff_order_detail_critical_alert"
                    android:textColor="#FF8080"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAllergyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFB3B3"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAllergyMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="#E8AAAA"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Customer request card -->
            <LinearLayout
                android:id="@+id/cardRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_staff_detail_dark_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/staff_order_detail_customer_request"
                    android:textColor="#CF843F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Quote block with left accent line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="#CF843F"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvCustomerRequest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="#D8C8BC"
                        android:textSize="15sp"
                        android:textStyle="italic" />

                </LinearLayout>

                <!-- Tags row (populated dynamically) -->
                <LinearLayout
                    android:id="@+id/containerTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />

            </LinearLayout>

            <!-- Action buttons -->
            <TextView
                android:id="@+id/btnStartPreparing"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_staff_detail_action_card"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/staff_order_detail_start_preparing"
                android:textColor="#CF843F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnStartBaking"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_staff_detail_action_card"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/staff_order_detail_start_baking"
                android:textColor="#CF843F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMarkReady"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_primary_gold"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/staff_order_detail_mark_ready"
                android:textColor="#3A210D"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom nav -->
    <include
        android:id="@+id/staffBottomNav"
        layout="@layout/layout_staff_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="86dp" />

</LinearLayout>

