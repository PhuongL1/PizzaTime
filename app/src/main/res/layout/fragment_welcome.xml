<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="520dp">

            <ImageView
                android:id="@+id/imgHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/img_welcome_hero" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_welcome_hero_radial" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_welcome_hero_linear" />

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgLocation"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/welcome_location_label"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.07"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/welcome_location_value"
                        android:textAllCaps="true"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/pt_gold"
                    android:textSize="32sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/welcome_avatar_content_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PizzaTime.Circle"
                    app:strokeColor="@color/pt_stroke_gold"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvChip"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_welcome_chip"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.13"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="@string/welcome_chip"
                    android:textAllCaps="true"
                    android:textColor="@color/pt_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/welcome_hero_title"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="27sp" />

                <TextView
                    android:id="@+id/tvHeroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/welcome_hero_subtitle"
                    android:textColor="@color/pt_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/actionSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/btnStartOrdering"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_welcome_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/welcome_start_ordering"
                android:textColor="@color/pt_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_welcome_button_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/welcome_login"
                android:textColor="@color/pt_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScrollToDiscover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/welcome_scroll_to_discover"
                android:textColor="@color/pt_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/pt_gold_dark" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/featureSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="38dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:id="@+id/cardWoodFired"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/bg_welcome_feature_card"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgFire"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start"
                    android:layout_marginBottom="36dp"
                    android:contentDescription="@string/welcome_wood_fired_content_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fire" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_wood_fired_title"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/welcome_wood_fired_subtitle"
                    android:textColor="@color/pt_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardMidnightDelivery"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_welcome_feature_card"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgDelivery"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="start"
                    android:layout_marginBottom="36dp"
                    android:contentDescription="@string/welcome_delivery_content_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_midnight_delivery" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_delivery_title"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/welcome_delivery_subtitle"
                    android:textColor="@color/pt_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:letterSpacing="0.22"
                android:text="@string/welcome_footer"
                android:textColor="@color/pt_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>