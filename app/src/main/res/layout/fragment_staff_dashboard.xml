<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staffDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark">

    <include
        android:id="@+id/staffTopBar"
        layout="@layout/layout_staff_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/statusChipScroll"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/staffTopBar">

        <LinearLayout
            android:id="@+id/statusChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/chipNewOrders"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@drawable/bg_chip_selected_gold"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="150dp"
                android:paddingHorizontal="22dp"
                android:text="@string/staff_chip_new_orders"
                android:textColor="@color/pt_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipConfirmed"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_chip_unselected_dark"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="145dp"
                android:paddingHorizontal="22dp"
                android:text="@string/staff_chip_confirmed"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipPreparing"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_chip_unselected_dark"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="145dp"
                android:paddingHorizontal="22dp"
                android:text="@string/staff_chip_preparing"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipReady"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_chip_unselected_dark"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="115dp"
                android:paddingHorizontal="22dp"
                android:text="@string/staff_chip_ready"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStaffOrders"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/staffBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusChipScroll" />

    <TextView
        android:id="@+id/tvEmptyOrders"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="@string/staff_empty_orders"
        android:textColor="@color/pt_text_secondary_dark_bg"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/staffBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusChipScroll" />

    <include
        android:id="@+id/staffBottomNav"
        layout="@layout/layout_staff_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
