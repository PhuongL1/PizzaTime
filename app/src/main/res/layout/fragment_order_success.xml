<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.customer.ordersuccess.OrderSuccessFragment">

    <View
        android:id="@+id/topHeader"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:background="@drawable/bg_order_success_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.26"
        android:text="@string/order_success_brand"
        android:textColor="@color/pt_copper"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/topHeader"
        app:layout_constraintEnd_toEndOf="@id/topHeader"
        app:layout_constraintStart_toStartOf="@id/topHeader"
        app:layout_constraintTop_toTopOf="@id/topHeader" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/heroArea"
                android:layout_width="224dp"
                android:layout_height="224dp"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:layout_width="208dp"
                    android:layout_height="208dp"
                    android:layout_gravity="center"
                    android:alpha="0.34"
                    android:background="@drawable/bg_order_success_glow_circle" />

                <FrameLayout
                    android:layout_width="184dp"
                    android:layout_height="184dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_order_success_image_circle"
                    android:clipToOutline="true"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/ivHeroPizza"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true"
                        android:contentDescription="@string/order_success_hero_description"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/img_pizza_time" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCheckIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_order_success_check_circle"
                    android:gravity="center"
                    android:text="@string/order_success_check_icon"
                    android:textColor="@color/pt_text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:letterSpacing="0.10"
                android:textColor="@color/pt_copper"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="ORDER ID #PT-9823" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Order Confirmed" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="22dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Your artisan creation is being prepared with care in our wood-fired oven." />

            <LinearLayout
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_order_success_info_card"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/tvClockIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/order_success_estimated_arrival"
                    android:src="@drawable/ic_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/order_success_estimated_arrival"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvEstimatedArrival"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="25-35 min" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/pt_stroke_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:letterSpacing="0.08"
                        android:text="@string/order_success_status"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvStatusValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="end"
                        android:textColor="@color/pt_copper"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Preparing" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnTrackPizza"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_order_success_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/order_success_track_pizza"
                android:textColor="@color/pt_text_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnReturnHome"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_order_success_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/order_success_return_home"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
