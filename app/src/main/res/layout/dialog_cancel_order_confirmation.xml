<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cancel_order_dialog_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_cancel_order_warning_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans"
                android:text="!"
                android:textColor="@color/pt_danger_text"
                android:textSize="34sp"
                android:textStyle="bold" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvCancelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="Cancel this order?"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvCancelMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="This order will be cancelled. This action may not be reversible."
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="-24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="-24dp"
            android:background="@color/pt_divider_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:text="ORDER ID"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOrderIdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#PT-1048"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="22sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:text="STATUS"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="READY"
                    android:textColor="@color/pt_copper"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="-24dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="-24dp"
            android:background="@color/pt_divider_dark" />

        <TextView
            android:id="@+id/tvReasonLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Cancel reason (optional)"
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etCancelReason"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cancel_order_reason_input"
            android:gravity="top|start"
            android:hint="e.g. Guest requested change..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textColorHint="@color/pt_text_hint_dark_bg"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnCancelOrder"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_cancel_order_danger_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="⊗  CANCEL ORDER"
            android:textColor="@color/pt_danger_button_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKeepOrder"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_cancel_order_keep_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="KEEP ORDER"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>