<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.customer.promos.CustomerPromoCodesFragment">

    <include
        android:id="@+id/customerTopBar"
        layout="@layout/layout_customer_top_bar"
        android:layout_width="0dp"
        android:layout_height="66dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingStart="30dp"
        android:paddingTop="44dp"
        android:paddingEnd="30dp"
        android:paddingBottom="0dp"
        app:layout_constraintBottom_toTopOf="@id/customerBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/customerTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="37sp"
                android:textStyle="bold"
                tools:text="Rewards &amp; Promos" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Elevate your late-night ritual with exclusive artisan offers." />

            <HorizontalScrollView
                android:id="@+id/tabsScroll"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="38dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipActive"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_customer_promo_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minWidth="110dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/customer_promo_tab_active"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipPastRewards"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_customer_promo_chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minWidth="150dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/customer_promo_tab_past_rewards"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipPointsHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_customer_promo_chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:minWidth="150dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/customer_promo_tab_points_history"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/activePromosContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvUsedExpiredTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.12"
                android:text="@string/customer_promo_used_expired"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pastPromosContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <include
        android:id="@+id/customerBottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>