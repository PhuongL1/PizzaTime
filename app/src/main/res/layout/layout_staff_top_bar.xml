<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staffTopBarRoot"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:background="@drawable/bg_top_bar_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/staff_menu_content_description"
            android:padding="5dp"
            android:src="@drawable/ic_menu"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotificationBadge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_customer_notifications_menu_badge"
            android:clickable="false"
            android:elevation="2dp"
            android:focusable="false"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:minWidth="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:textColor="@color/pt_white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvAdminTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:text="@string/staff_dashboard_title"
        android:textColor="@color/pt_gold_light"
        android:textSize="24sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="@string/staff_avatar_content_description"
        android:padding="2dp">

        <TextView
            android:id="@+id/tvAdminAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_customer_account_avatar_fill"
            android:gravity="center"
            android:text="@string/staff_avatar_initial"
            android:textColor="@color/pt_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAdminAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/staff_avatar_content_description"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PizzaTime.Circle" />

    </FrameLayout>

</LinearLayout>
