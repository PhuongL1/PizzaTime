<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_customer_favorites_card"
    android:orientation="vertical"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="330dp">

        <ImageView
            android:id="@+id/ivFavoriteImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/customer_favorites_item_image_description"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_pizza_time" />

        <TextView
            android:id="@+id/tvImagePlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/pt_surface_soft"
            android:gravity="center"
            android:text="@string/customer_favorites_image_placeholder"
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="28sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnHeart"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_customer_favorites_heart_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/customer_favorites_heart"
            android:textColor="@color/pt_copper"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_customer_favorites_badge"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/pt_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="CHEF'S PICK" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/tvFavoriteName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="31sp"
            tools:text="The Midnight Truffle" />

        <TextView
            android:id="@+id/tvFavoritePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:letterSpacing="0.08"
            android:textColor="@color/pt_copper"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="$24.00" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFavoriteDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:textColor="@color/pt_text_secondary_dark_bg"
        android:textSize="17sp"
        tools:text="Black truffle cream, wild mushrooms, thyme, and fontina cheese." />

    <TextView
        android:id="@+id/btnAddToCart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_customer_favorites_add_button"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/customer_favorites_add_to_cart"
        android:textColor="@color/pt_text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>