<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/orderCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_product_card_light"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CF843F"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="#PT-9824" />

        <TextView
            android:id="@+id/tvTimeAgo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:textColor="#CF843F"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="2 MINS AGO" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#33302E"
            android:textSize="25sp"
            android:textStyle="bold"
            tools:text="Alessandro Rossi" />

        <TextView
            android:id="@+id/tvFulfillment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="#4B4744"
            android:textSize="17sp"
            tools:text="Delivery" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E3DCD7" />

    <TextView
        android:id="@+id/tvOrderSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="#33302E"
        android:textSize="17sp"
        tools:text="1x Truffle Mushroom Pizza, 1x San Pellegrino" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="#CF843F"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="$34.50" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#E3DCD7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrimaryAction"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_gold"
            android:letterSpacing="0.14"
            android:stateListAnimator="@null"
            android:text="@string/staff_action_confirm_order"
            android:textColor="#3A210D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnViewDetails"
            android:layout_width="118dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_outline_gold"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/staff_action_details"
            android:textColor="#CF843F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableEndCompat="@drawable/ic_arrow_right" />

    </LinearLayout>

</LinearLayout>