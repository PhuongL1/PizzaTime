<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_customer_promo_card"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivPromoImage"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:contentDescription="@string/customer_promo_image_description"
        android:scaleType="centerCrop"
        tools:src="@drawable/img_pizza_time" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="26dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:textColor="@color/pt_copper"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="LIMITED EDITION" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_customer_promo_status_active"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="2 DAYS LEFT" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="31sp"
            tools:text="MIDNIGHT20" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/pt_text_secondary_dark_bg"
            android:textSize="17sp"
            tools:text="20% off all signature wood-fired pizzas after 10 PM." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMetaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="11sp"
                    tools:text="EXPIRES" />

                <TextView
                    android:id="@+id/tvMetaValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Oct 24, 2024" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnApply"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_customer_promo_apply_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/customer_promo_apply"
                android:textColor="@color/pt_text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>