<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeTopBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_top_bar_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <ImageView
        android:id="@+id/btnMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/menu_drawer_content_description"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_menu"
        app:tint="@color/pt_gold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgHomeLocation"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/welcome_location_label"
                android:padding="1dp"
                android:src="@drawable/ic_location"
                app:tint="@color/pt_gold" />

            <TextView
                android:id="@+id/tvDeliveringTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.10"
                android:text="@string/home_delivering_to"
                android:textColor="@color/pt_gold"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHomeLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/home_location"
            android:textColor="@color/pt_text_primary_dark_bg"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnHomeAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/home_avatar_content_description"
        android:focusable="true"
        android:padding="2dp">

        <TextView
            android:id="@+id/tvHomeAvatarInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_customer_account_avatar_fill"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/pt_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="JV" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivHomeAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/home_avatar_content_description"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PizzaTime.Circle"
            app:strokeColor="@color/pt_gold"
            app:strokeWidth="1dp"
            tools:src="@drawable/bg_avatar" />

    </FrameLayout>

</LinearLayout>
