<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_assign_shipper_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_customer_account_avatar_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShipperName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeliveryMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_order_list"
                android:drawablePadding="8dp"
                android:drawableTint="@color/pt_text_secondary_dark_bg"
                android:gravity="center_vertical"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAvailability"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/pt_copper"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivSelectedCheck"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-18dp"
        android:layout_marginEnd="-18dp"
        android:background="@drawable/bg_assign_shipper_selected_check"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_check"
        android:visibility="gone" />

</FrameLayout>