<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.auth.forgot.ForgotPasswordFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <FrameLayout
                android:id="@+id/forgotPasswordTopBar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_login_back_button"
                    android:clickable="true"
                    android:contentDescription="@string/common_back_content_description"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_back"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="@string/forgot_password_brand"
                    android:textColor="@color/pt_copper"
                    android:textSize="30sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <View
                android:id="@+id/brandDivider"
                android:layout_width="42dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_forgot_password_brand_divider" />

            <LinearLayout
                android:id="@+id/cardLoginForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_surface_panel"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="32dp"
                android:paddingEnd="28dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/forgot_password_title"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="18dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/forgot_password_subtitle"
                    android:textColor="@color/pt_text_secondary_dark_bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInputLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.14"
                    android:text="@string/forgot_password_input_label"
                    android:textColor="@color/pt_border_warm"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="9dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_forgot_password_input"
                    android:drawableStart="@drawable/ic_auth_email"
                    android:drawablePadding="10dp"
                    android:hint="@string/forgot_password_input_hint"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/pt_text_dark"
                    android:textColorHint="@color/pt_border_warm"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnSendResetInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/bg_forgot_password_send_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:text="@string/forgot_password_send_button"
                    android:textColor="@color/pt_text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="28dp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
