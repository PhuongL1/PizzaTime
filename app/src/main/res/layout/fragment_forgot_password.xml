<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_background"
    tools:context=".feature.auth.forgot.ForgotPasswordFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/forgot_password_brand"
                android:textColor="@color/pt_copper"
                android:textSize="54sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/brandDivider"
                android:layout_width="96dp"
                android:layout_height="3dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_forgot_password_brand_divider" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/forgot_password_title"
                android:textColor="@color/pt_text_primary_dark_bg"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:text="@string/forgot_password_subtitle"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInputLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="76dp"
                android:letterSpacing="0.14"
                android:text="@string/forgot_password_input_label"
                android:textColor="@color/pt_border_warm"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAccount"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="18dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_forgot_password_input"
                android:drawableStart="@drawable/ic_auth_email"
                android:drawablePadding="18dp"
                android:hint="@string/forgot_password_input_hint"
                android:inputType="textEmailAddress"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/pt_text_dark"
                android:textColorHint="@color/pt_border_warm"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/btnSendResetInstructions"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="64dp"
                android:background="@drawable/bg_forgot_password_send_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/forgot_password_send_button"
                android:textColor="@color/pt_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="76dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/forgot_password_back_to_login"
                android:textColor="@color/pt_text_secondary_dark_bg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>