<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminRecentOrderRoot"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_admin_recent_order_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_admin_recent_icon"
        android:contentDescription="@string/admin_order_icon_content_description"
        android:padding="12dp"
        android:src="@drawable/ic_order_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentOrderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pt_white"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Order #8842" />

        <TextView
            android:id="@+id/tvRecentOrderSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pt_white_light"
            android:textSize="13sp"
            android:textStyle="italic"
            tools:text="2x Truffle Pepperoni, 1x Nero Soda" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvRecentOrderPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/pt_gold_light"
        android:textSize="16sp"
        tools:text="$42.00" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/common_chevron_right_content_description"
        android:paddingStart="8dp"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
