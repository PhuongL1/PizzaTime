<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminMenuItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="22dp"
    android:background="@drawable/bg_manage_menu_card"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <ImageView
            android:id="@+id/ivMenuImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/manage_menu_image_content_description"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_welcome_hero" />

        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="22dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_manage_menu_badge"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingHorizontal="18dp"
            android:textColor="#3A210D"
            android:textSize="15sp"
            tools:text="SIGNATURE" />

        <TextView
            android:id="@+id/tvSoldOut"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_manage_menu_sold_out"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/manage_menu_sold_out"
            android:textColor="@color/pt_white"
            android:textSize="15sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/menuInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:id="@+id/menuNamePriceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMenuName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/pt_white"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Spiced Honey Heat" />

            <TextView
                android:id="@+id/tvMenuPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pt_gold_light"
                android:textSize="17sp"
                tools:text="$24.00" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMenuDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/pt_white_light"
            android:textSize="17sp"
            tools:text="Sourdough base, spicy calabrese, wildflower honey, and fresh basil." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#2F2926" />

        <LinearLayout
            android:id="@+id/menuActionRow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvailableLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_menu_available"
                android:textColor="@color/pt_white_light"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/toggleAvailability"
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_manage_menu_toggle_on"
                android:gravity="end|center_vertical"
                android:padding="3dp">

                <View
                    android:id="@+id/toggleKnob"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_manage_menu_toggle_knob" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/manage_menu_edit_content_description"
                android:padding="10dp"
                android:src="@drawable/ic_edit" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>