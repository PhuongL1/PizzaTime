<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shipperDeliveryDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerDeliveryDetail"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_top_bar_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/common_back_arrow"
            android:textColor="@color/staff_nav_unselected"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvOrderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/pt_copper"
            android:textSize="26sp"
            tools:text="Order #8821" />

        <FrameLayout
            android:id="@+id/detailAvatarFrame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar_circle"
            android:contentDescription="@string/staff_avatar_content_description"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvDetailAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_customer_account_avatar_fill"
                android:gravity="center"
                android:text="@string/staff_avatar_initial"
                android:textColor="@color/pt_text_primary"
                android:textStyle="bold" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetailAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/staff_avatar_content_description"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PizzaTime.Circle" />

        </FrameLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:id="@+id/progressRow"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <LinearLayout
                    android:id="@+id/progressIconRow"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/progressPickedUpCircle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_shipper_progress_done_circle">

                        <ImageView
                            android:id="@+id/icProgressPickedUp"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/shipper_detail_progress_picked_up"
                            android:src="@drawable/ic_shipper_progress_check" />

                    </FrameLayout>

                    <View
                        android:id="@+id/progressLinePickupToArriving"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="14dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_shipper_progress_line_active" />

                    <FrameLayout
                        android:id="@+id/progressArrivingCircle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_shipper_progress_active_circle">

                        <ImageView
                            android:id="@+id/icProgressArriving"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/shipper_detail_progress_arriving"
                            android:src="@drawable/ic_shipper_progress_truck" />

                    </FrameLayout>

                    <View
                        android:id="@+id/progressLineArrivingToDelivered"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="14dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_shipper_progress_line_inactive" />

                    <FrameLayout
                        android:id="@+id/progressDeliveredCircle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_shipper_progress_inactive_circle">

                        <ImageView
                            android:id="@+id/icProgressDelivered"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:alpha="0.55"
                            android:contentDescription="@string/shipper_detail_progress_delivered"
                            android:src="@drawable/ic_shipper_progress_double_check" />

                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/progressLabelRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProgressPickedUp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="@string/shipper_detail_progress_picked_up"
                        android:textColor="@color/pt_gold_light"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgressArriving"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/shipper_detail_progress_arriving"
                        android:textColor="@color/pt_gold_light"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgressDelivered"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/shipper_detail_progress_delivered"
                        android:textColor="@color/pt_text_muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pickupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_shipper_active_card"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/shipper_detail_pickup"
                    android:textColor="@color/pt_gold_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStoreName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:text="PizzaTime" />

                <TextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/pt_text_secondary"
                    android:textSize="18sp"
                    tools:text="123 Nguyen Trai, Ha Noi" />

                <TextView
                    android:id="@+id/tvStorePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_secondary"
                    android:textSize="16sp"
                    tools:text="0900000000" />

                <TextView
                    android:id="@+id/tvPickupCoordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_muted"
                    android:textSize="13sp"
                    tools:text="21.027800, 105.834200" />

                <TextView
                    android:id="@+id/btnOpenPickupMap"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button_primary_gold"
                    android:gravity="center"
                    android:text="@string/shipper_open_pickup_map"
                    android:textColor="@color/pt_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/customerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_shipper_active_card"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/shipper_detail_customer"
                    android:textColor="@color/pt_gold_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="Alessandra Rossi" />

                <TextView
                    android:id="@+id/tvCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_secondary"
                    android:textSize="16sp"
                    tools:text="0900000000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="42dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCallCustomer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary_gold"
                        android:gravity="center"
                        android:text="@string/shipper_detail_call_customer"
                        android:textColor="@color/pt_text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnNavigate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_shipper_detail_disabled_button"
                        android:gravity="center"
                        android:text="@string/shipper_open_delivery_map"
                        android:textColor="@color/pt_text_secondary_dark_bg"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mapAddressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_shipper_map_card"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="220dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/shipper_detail_delivery_address"
                    android:textColor="@color/pt_gold_light"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeliveryAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/pt_text_primary_dark_bg"
                    android:textSize="18sp"
                    tools:text="422 Artisan Way, Suite 8B&#10;Manhattan, NY 10014" />

                <TextView
                    android:id="@+id/tvDeliveryCoordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_muted"
                    android:textSize="13sp"
                    tools:text="21.027800, 105.834200" />

                <TextView
                    android:id="@+id/tvDeliveryDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_muted"
                    android:textSize="13sp"
                    tools:text="3.2 km" />

                <TextView
                    android:id="@+id/tvDeliveryFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/pt_text_muted"
                    android:textSize="13sp"
                    tools:text="$4.50" />

                <LinearLayout
                    android:id="@+id/courierNoteCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_shipper_note_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/shipper_detail_courier_note"
                        android:textColor="@color/pt_gold_light"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCourierNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/staff_nav_unselected"
                        android:textSize="16sp"
                        tools:text="&quot;Gate code is 1992.&quot;" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/paymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_shipper_active_card"
                android:orientation="vertical"
                android:padding="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shipper_detail_payment_due"
                        android:textColor="@color/pt_text_primary_dark_bg"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaymentAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/pt_gold_light"
                            android:textSize="28sp"
                            tools:text="$42.50" />

                        <TextView
                            android:id="@+id/tvPaymentMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.12"
                            android:textColor="@color/pt_gold_light"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="CASH ON DELIVERY" />

                        <TextView
                            android:id="@+id/tvPaymentStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="0.12"
                            android:textColor="@color/pt_text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="UNPAID" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="22dp"
                    android:background="@color/pt_divider_dark" />

                <LinearLayout
                    android:id="@+id/llPaymentItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnConfirmDelivery"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="42dp"
                android:background="@drawable/bg_button_primary_gold"
                android:gravity="center"
                android:text="@string/shipper_detail_confirm_delivery"
                android:textColor="@color/pt_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/staffBottomNav"
        layout="@layout/layout_staff_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp" />

</LinearLayout>
