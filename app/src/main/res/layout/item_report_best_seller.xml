<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootBestSeller"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/ivPizza"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_report_best_seller_image"
            android:contentDescription="@string/best_seller_image"
            android:padding="12dp"
            android:src="@drawable/ic_admin_view_reports" />

        <TextView
            android:id="@+id/tvRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/pt_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="#1" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPizzaName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pt_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Truffle Honey Artisan" />

            <TextView
                android:id="@+id/tvSold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/pt_gold_light"
                android:textSize="16sp"
                tools:text="48 SOLD" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSold"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="86"
            android:progressDrawable="@drawable/progress_report_bar"
            tools:progress="86" />
    </LinearLayout>

</LinearLayout>