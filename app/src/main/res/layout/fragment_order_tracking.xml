<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderTrackingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark">

    <ScrollView
        android:id="@+id/trackingScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="128dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/trackingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:id="@+id/trackingTopBar"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@drawable/bg_top_bar_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/menu_drawer_content_description"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/tvTrackingBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:text="@string/detail_brand"
                    android:textColor="@color/pt_gold"
                    android:textSize="32sp" />

                <ImageView
                    android:id="@+id/btnCart"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/detail_cart_content_description"
                    android:src="@drawable/ic_bag" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/mapSection"
                android:layout_width="match_parent"
                android:layout_height="540dp"
                android:background="@drawable/bg_tracking_map_placeholder">

                <TextView
                    android:id="@+id/tvMapLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/tracking_map_location"
                    android:textColor="#2B2B2B"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#77FFFFFF" />

                <LinearLayout
                    android:id="@+id/etaCard"
                    android:layout_width="match_parent"
                    android:layout_height="156dp"
                    android:layout_marginStart="34dp"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="34dp"
                    android:background="@drawable/bg_tracking_eta_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOrderNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.10"
                            android:text="@string/tracking_order_number"
                            android:textColor="@color/pt_gold"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="serif"
                            android:includeFontPadding="false"
                            android:text="@string/tracking_eta"
                            android:textColor="@color/pt_text_primary"
                            android:textSize="38sp" />

                        <TextView
                            android:id="@+id/tvEtaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/tracking_eta_label"
                            android:textColor="@color/pt_text_secondary"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <View
                        android:id="@+id/etaDriverMarker"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_circle_gold_soft" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/liveStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_marginTop="52dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/bg_tracking_status_card"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/tvLiveStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tracking_live_status"
                    android:textColor="@color/pt_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/statusStepContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/trackingProductCard"
                android:layout_width="match_parent"
                android:layout_height="138dp"
                android:layout_marginStart="34dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/bg_tracking_product_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:contentDescription="@string/tracking_product_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_welcome_hero" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pt_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProductOption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/pt_text_secondary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvProductPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/pt_text_secondary"
                        android:textSize="18sp" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnProductDetail"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_tracking_arrow_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/menu_open_pizza"
                        android:src="@drawable/ic_arrow_right" />

                </FrameLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/btnSupport"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginStart="34dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/bg_support_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tracking_need_support"
                android:textColor="@color/pt_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp" />

</FrameLayout>