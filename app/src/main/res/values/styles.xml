<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="ShapeAppearance.PizzaTime.Circle"
        parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style
        name="ShapeAppearance.PizzaTime.HeroCard"
        parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlayPizzaTimeBottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/WidgetPizzaTimeBottomSheet</item>
    </style>

    <style name="WidgetPizzaTimeBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="CustomerMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_customer_menu_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="CustomerMenuTextGroup">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">22dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="CustomerMenuTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pt_text_primary_dark_bg</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CustomerMenuSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/pt_text_secondary_dark_bg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomerMenuIconImage">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_customer_menu_icon_box</item>
        <item name="android:padding">15dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/pt_copper</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="CustomerMenuChevronImage">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/pt_text_secondary_dark_bg</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="KitchenOrderDetailToppingText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/pt_text_dark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KitchenOrderDetailActionButtonDark">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">116dp</item>
        <item name="android:background">@drawable/bg_kitchen_order_detail_action_dark</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_copper</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KitchenOrderDetailActionButtonPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">116dp</item>
        <item name="android:background">@drawable/bg_kitchen_order_detail_action_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_text_dark</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ManageOrdersStatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">98dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/bg_manage_orders_stat_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/pt_text_primary_dark_bg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ManageOrdersFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">94dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="AddEditProductLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/pt_text_secondary_dark_bg</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AddEditProductInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_add_edit_product_input</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/pt_text_dark</item>
        <item name="android:textColorHint">@color/pt_text_secondary_dark_bg</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AddEditProductInputText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_add_edit_product_input</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/pt_text_dark</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AddEditProductChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">132dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AddEditProductOptionCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/bg_add_edit_product_option_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="AddEditProductCheckBox">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_text_primary_dark_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AddEditProductOptionText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/pt_text_primary_dark_bg</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CustomerNotificationsNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_text_secondary_dark_bg</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomerNotificationsNavItemSelected">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_customer_notifications_nav_selected</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_text_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SupportBottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_text_secondary_dark_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SupportBottomNavItemSelected">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_support_nav_selected</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pt_text_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PizzaTimeRightDrawerDialog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="StaffDrawerMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/pt_border_warm</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>