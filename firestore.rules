rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && role() == "ADMIN";
    }

    function isStaff() {
      return isActiveUser() && role() == "STAFF";
    }

    function isKitchen() {
      return isActiveUser() && role() == "KITCHEN";
    }

    function isShipper() {
      return isActiveUser() && role() == "SHIPPER";
    }

    function isCustomer() {
      return isActiveUser() && role() == "CUSTOMER";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaffRole() {
      return isStaff() || isKitchen() || isShipper() || isAdmin();
    }

    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "id",
        "role",
        "active",
        "createdAt",
        "doughPoints",
        "lifetimeSpend",
        "completedOrders"
      ]);
    }

    function validCustomerProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == "CUSTOMER"
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          "id",
          "name",
          "email",
          "phone",
          "role",
          "active",
          "avatarUrl",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validOrderCreate() {
      return isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "PENDING";
    }

    function orderStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "updatedAt",
        "statusHistory"
      ]);
    }
    function shipperStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "updatedAt",
        "statusHistory",
        "shipperId",
        "loyaltyAwarded",
        "earnedPoints",
        "paymentStatus",
        "paymentMethod",
        "paidAt",
        "deliveredAt",
        "collectedByShipperId",
        "collectedAmount",
        "cashCollected"
      ]);
    }

    function shipperPaymentCollectionFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "paymentStatus",
        "paymentMethod",
        "paidAt",
        "deliveredAt",
        "collectedByShipperId",
        "collectedAmount",
        "cashCollected"
      ])
        || (
          statusTransition("DELIVERING", "DELIVERED")
          && request.resource.data.paymentStatus == "PAID"
          && request.resource.data.paymentMethod == "CASH_ON_DELIVERY"
          && request.resource.data.paidAt == request.time
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.collectedByShipperId == request.auth.uid
          && request.resource.data.collectedAmount is number
          && request.resource.data.collectedAmount >= 0
          && request.resource.data.cashCollected == true
        );
    }

    function shipperLoyaltyOrderFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "loyaltyAwarded",
        "earnedPoints"
      ])
        || (
          statusTransition("DELIVERING", "DELIVERED")
          && resource.data.loyaltyAwarded != true
          && request.resource.data.loyaltyAwarded == true
          && request.resource.data.earnedPoints is number
          && request.resource.data.earnedPoints >= 0
        );
    }

    function shipperLoyaltyUserUpdate() {
      return isShipper()
        && resource.data.role == "CUSTOMER"
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "doughPoints",
          "lifetimeSpend",
          "completedOrders",
          "updatedAt"
        ])
        && request.resource.data.doughPoints is number
        && request.resource.data.lifetimeSpend is number
        && request.resource.data.completedOrders is number
        && request.resource.data.doughPoints >= resource.data.get("doughPoints", 0)
        && request.resource.data.lifetimeSpend >= resource.data.get("lifetimeSpend", 0)
        && request.resource.data.completedOrders == resource.data.get("completedOrders", 0) + 1
        && request.resource.data.updatedAt == request.time;
    }

    function validStatusHistoryField() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["statusHistory"])
        || request.resource.data.statusHistory is list;
    }

    function statusTransition(fromStatus, toStatus) {
      return resource.data.status == fromStatus
        && request.resource.data.status == toStatus;
    }

    function staffStatusTransition() {
      return statusTransition("PENDING", "CONFIRMED");
    }

    function customerCancelTransition() {
      return isCustomer()
        && resource.data.customerId == request.auth.uid
        && statusTransition("PENDING", "CANCELLED");
    }

    function staffCancelTransition() {
      return statusTransition("PENDING", "CANCELLED")
        || statusTransition("CONFIRMED", "CANCELLED");
    }

    function kitchenStatusTransition() {
      return statusTransition("CONFIRMED", "PREPARING")
        || statusTransition("PREPARING", "BAKING")
        || statusTransition("BAKING", "READY");
    }

    function shipperStatusTransition() {
      return statusTransition("READY", "ASSIGNED_TO_SHIPPER")
        || statusTransition("READY", "DELIVERING")
        || statusTransition("ASSIGNED_TO_SHIPPER", "DELIVERING")
        || statusTransition("DELIVERING", "DELIVERED");
    }

    function shipperOwnsOrClaimsOrder() {
      return (
        resource.data.status == "READY"
        && resource.data.get("shipperId", "") == ""
        && request.resource.data.shipperId == request.auth.uid
      )
        || (
          resource.data.status in ["ASSIGNED_TO_SHIPPER", "DELIVERING"]
          && resource.data.get("shipperId", "") == request.auth.uid
          && request.resource.data.get("shipperId", "") == request.auth.uid
        );
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /promoCodes/{promoCodeId} {
      allow read: if isStaffRole()
        || (isCustomer() && resource.data.active == true);
      allow write: if isAdmin();
    }

    match /appConfig/{configId} {
      allow get, list: if isActiveUser() && configId == "store";
      allow create, update, delete: if isAdmin() && configId == "store";
    }

    match /users/{userId} {
      allow get: if (isOwner(userId) && isActiveUser()) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || validCustomerProfileCreate(userId);
      allow update: if isAdmin()
        || (isOwner(userId) && isActiveUser() && protectedUserFieldsUnchanged())
        || shipperLoyaltyUserUpdate();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrderCreate();
      allow get, list: if isAdmin()
        || isStaff()
        || isKitchen()
        || isShipper()
        || (isCustomer() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin()
        || (isCustomer() && orderStatusOnlyUpdate() && validStatusHistoryField() && customerCancelTransition())
        || (
          isStaff()
          && orderStatusOnlyUpdate()
          && validStatusHistoryField()
          && (staffStatusTransition() || staffCancelTransition())
        )
        || (isKitchen() && orderStatusOnlyUpdate() && validStatusHistoryField() && kitchenStatusTransition())
        || (
          isShipper()
          && shipperStatusUpdate()
          && shipperOwnsOrClaimsOrder()
          && shipperPaymentCollectionFieldsValid()
          && shipperLoyaltyOrderFieldsValid()
          && validStatusHistoryField()
          && shipperStatusTransition()
        );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
