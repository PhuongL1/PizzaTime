rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && role() == "ADMIN";
    }

    function isStaff() {
      return isActiveUser() && role() == "STAFF";
    }

    function isKitchen() {
      return isActiveUser() && role() == "KITCHEN";
    }

    function isShipper() {
      return isActiveUser() && role() == "SHIPPER";
    }

    function isCustomer() {
      return isActiveUser() && role() == "CUSTOMER";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaffRole() {
      return isStaff() || isKitchen() || isShipper() || isAdmin();
    }

    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "id",
        "role",
        "active",
        "createdAt",
        "doughPoints",
        "lifetimeSpend",
        "completedOrders"
      ]);
    }

    function validCustomerProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == "CUSTOMER"
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          "id",
          "name",
          "email",
          "phone",
          "role",
          "active",
          "avatarUrl",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validOrderCodeId(orderId) {
      return orderId.matches('^[a-z]{2}-[0-9]{4}$');
    }

    function validOrderCreate(orderId) {
      return isCustomer()
        && validOrderCodeId(orderId)
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.orderCodeKey == orderId
        && request.resource.data.orderCode == "#" + orderId
        && request.resource.data.status == "PENDING"
        && validClientOrderPaymentInitialization()
        && request.resource.data.deliveryAddress is string
        && request.resource.data.deliveryAddress.size() > 0
        && request.resource.data.deliveryLocation is latlng
        && request.resource.data.items is list
        && request.resource.data.itemsSubtotal is number
        && request.resource.data.discountAmount is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.finalTotal is number
        && request.resource.data.total == request.resource.data.finalTotal
        && request.resource.data.keys().hasOnly([
          "customerId",
          "customerEmail",
          "customerName",
          "customerPhone",
          "storeName",
          "pickupAddress",
          "pickupLat",
          "pickupLng",
          "storePhone",
          "status",
          "orderType",
          "paymentMethod",
          "paymentStatus",
          "cashCollected",
          "deliveryHandoffStatus",
          "deliveryAddress",
          "deliveryLocation",
          "distanceKm",
          "itemsSubtotal",
          "subtotal",
          "deliveryFee",
          "discountAmount",
          "discount",
          "promoCode",
          "finalTotal",
          "total",
          "note",
          "items",
          "statusHistory",
          "createdAt",
          "updatedAt",
          "orderId",
          "orderCodeKey",
          "orderCode"
        ]);
    }

    function validClientOrderPaymentInitialization() {
      return request.resource.data.cashCollected == false
        && !request.resource.data.keys().hasAny([
          "paymentProvider",
          "paymentAttemptId",
          "paymentReference",
          "paidAt",
          "providerTransactionId",
          "shipperArrivedAt",
          "customerReceivedAt",
          "customerReceiptConfirmedBy",
          "deliveryCompletedAt",
          "deliveredAt",
          "collectedByShipperId",
          "collectedAmount"
        ])
        && (
          (
            request.resource.data.paymentMethod == "COD"
            && request.resource.data.paymentStatus == "NOT_REQUIRED"
            && request.resource.data.deliveryHandoffStatus == "NOT_REQUIRED"
          )
          || (
            request.resource.data.paymentMethod == "VNPAY"
            && request.resource.data.paymentStatus == "PENDING"
            && request.resource.data.deliveryHandoffStatus == "LOCKED"
          )
        );
    }

    function canGetOrder(orderId) {
      return isAdmin()
        || isStaff()
        || isKitchen()
        || isShipper()
        || (
          isCustomer()
          && (
            (!exists(/databases/$(database)/documents/orders/$(orderId)) && validOrderCodeId(orderId))
            || resource.data.customerId == request.auth.uid
          )
        );
    }

    function orderDocument(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function canReadCurrentTracking(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && (
          (
            isCustomer()
            && orderDocument(orderId).data.customerId == request.auth.uid
          )
          || (
            isShipper()
            && orderDocument(orderId).data.shipperId == request.auth.uid
          )
        );
    }

    function validCurrentTrackingFields() {
      return request.resource.data.keys().hasAll([
          "shipperId",
          "location",
          "accuracyMeters",
          "recordedAt",
          "updatedAt",
          "orderStatus",
          "schemaVersion"
        ])
        && request.resource.data.keys().hasOnly([
          "shipperId",
          "location",
          "accuracyMeters",
          "bearingDegrees",
          "speedMetersPerSecond",
          "recordedAt",
          "updatedAt",
          "orderStatus",
          "schemaVersion"
        ])
        && request.resource.data.shipperId is string
        && request.resource.data.shipperId == request.auth.uid
        && request.resource.data.location is latlng
        && request.resource.data.accuracyMeters is number
        && request.resource.data.accuracyMeters >= 0
        && request.resource.data.accuracyMeters <= 100
        && (
          !request.resource.data.keys().hasAny(["bearingDegrees"])
          || (
            request.resource.data.bearingDegrees is number
            && request.resource.data.bearingDegrees >= 0
            && request.resource.data.bearingDegrees < 360
          )
        )
        && (
          !request.resource.data.keys().hasAny(["speedMetersPerSecond"])
          || (
            request.resource.data.speedMetersPerSecond is number
            && request.resource.data.speedMetersPerSecond >= 0
            && request.resource.data.speedMetersPerSecond <= 100
          )
        )
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.recordedAt >= request.time - duration.value(10, "m")
        && request.resource.data.recordedAt <= request.time + duration.value(1, "m")
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.orderStatus == "DELIVERING"
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1;
    }

    function canWriteCurrentTracking(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && isShipper()
        && orderDocument(orderId).data.shipperId == request.auth.uid
        && orderDocument(orderId).data.status == "DELIVERING"
        && validCurrentTrackingFields();
    }

    function orderStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "updatedAt",
        "statusHistory",
        "cancellationReason",
        "statusReason",
        "cancelledBy"
      ]);
    }
    function kitchenStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "updatedAt",
        "statusHistory",
        "kitchenStage",
        "kitchenProgressPercent",
        "kitchenUpdatedAt",
        "cancellationReason",
        "statusReason",
        "cancelledBy"
      ]);
    }

    function kitchenProgressFieldsValid() {
      return request.resource.data.kitchenStage in ["PREPARING", "BAKING", "READY"]
        && request.resource.data.kitchenProgressPercent in [40, 75, 100]
        && request.resource.data.kitchenUpdatedAt == request.time;
    }
    function shipperStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "updatedAt",
        "statusHistory",
        "shipperId",
        "deliveredAt",
        "collectedByShipperId",
        "collectedAmount",
        "cashCollected"
      ]);
    }

    function shipperPaymentCollectionFieldsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "deliveredAt",
        "collectedByShipperId",
        "collectedAmount",
        "cashCollected"
      ])
        || (
          statusTransition("DELIVERING", "DELIVERED")
          && isCodOrder(resource.data)
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.collectedByShipperId == request.auth.uid
          && request.resource.data.collectedAmount is number
          && request.resource.data.collectedAmount >= 0
          && request.resource.data.cashCollected == true
        );
    }

    function validStatusHistoryField() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["statusHistory"])
        || request.resource.data.statusHistory is list;
    }

    function validProductRatingUpdate() {
      return isCustomer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "averageRating",
          "ratingCount",
          "ratingTotal",
          "updatedAt"
        ])
        && request.resource.data.averageRating is number
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingTotal is int
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5
        && request.resource.data.ratingCount >= 0
        && request.resource.data.ratingTotal >= 0;
    }

    function validProductReviewWrite(reviewId) {
      return isCustomer()
        && request.resource.data.keys().hasOnly([
          "reviewId",
          "orderId",
          "productId",
          "customerId",
          "rating",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.reviewId == reviewId
        && request.resource.data.orderId is string
        && request.resource.data.productId is string
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == "DELIVERED";
    }

    function statusTransition(fromStatus, toStatus) {
      return resource.data.status == fromStatus
        && request.resource.data.status == toStatus;
    }

    function staffStatusTransition() {
      return statusTransition("PENDING", "CONFIRMED")
        && (!isVnpayOrder(resource.data) || resource.data.paymentStatus == "PAID");
    }

    function customerCancelTransition() {
      return isCustomer()
        && resource.data.customerId == request.auth.uid
        && statusTransition("PENDING", "CANCELLED");
    }

    function staffCancelTransition() {
      return statusTransition("PENDING", "CANCELLED")
        || statusTransition("CONFIRMED", "CANCELLED");
    }

    function kitchenStatusTransition() {
      return statusTransition("CONFIRMED", "PREPARING")
        || statusTransition("PREPARING", "BAKING")
        || statusTransition("BAKING", "READY")
        || statusTransition("BAKING", "READY_FOR_DELIVERY");
    }

    function shipperStatusTransition() {
      return statusTransition("READY", "ASSIGNED_TO_SHIPPER")
        || statusTransition("READY_FOR_DELIVERY", "ASSIGNED_TO_SHIPPER")
        || statusTransition("READY", "DELIVERING")
        || statusTransition("READY_FOR_DELIVERY", "DELIVERING")
        || statusTransition("ASSIGNED_TO_SHIPPER", "DELIVERING")
        || statusTransition("DELIVERING", "DELIVERED");
    }

    function isCodOrder(data) {
      return data.get("paymentMethod", "COD") == "COD"
        || data.get("paymentMethod", "COD") == "CASH_ON_DELIVERY"
        || data.get("paymentMethod", "COD") == "CASH";
    }

    function isVnpayOrder(data) {
      return data.get("paymentMethod", "COD") == "VNPAY";
    }

    function paymentFieldsProtected() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "paymentMethod",
        "paymentStatus",
        "paymentProvider",
        "paymentAttemptId",
        "paymentReference",
        "paidAt",
        "providerTransactionId"
      ]);
    }

    function shipperArrivalTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "deliveryHandoffStatus",
        "shipperArrivedAt",
        "updatedAt"
      ])
        && isShipper()
        && resource.data.shipperId == request.auth.uid
        && isVnpayOrder(resource.data)
        && resource.data.paymentStatus == "PAID"
        && resource.data.status == "DELIVERING"
        && resource.data.get("deliveryHandoffStatus", "LOCKED") == "LOCKED"
        && request.resource.data.deliveryHandoffStatus == "AWAITING_CUSTOMER"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.shipperArrivedAt == request.time;
    }

    function customerReceiptTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "deliveryHandoffStatus",
        "customerReceivedAt",
        "customerReceiptConfirmedBy",
        "updatedAt"
      ])
        && isCustomer()
        && resource.data.customerId == request.auth.uid
        && isVnpayOrder(resource.data)
        && resource.data.paymentStatus == "PAID"
        && resource.data.status == "DELIVERING"
        && resource.data.get("deliveryHandoffStatus", "LOCKED") == "AWAITING_CUSTOMER"
        && request.resource.data.deliveryHandoffStatus == "CUSTOMER_CONFIRMED"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.customerReceivedAt == request.time
        && request.resource.data.customerReceiptConfirmedBy == request.auth.uid;
    }

    function shipperPrepaidCompletionTransition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "updatedAt",
        "statusHistory",
        "deliveryHandoffStatus",
        "deliveryCompletedAt",
        "deliveredAt"
      ])
        && isShipper()
        && resource.data.shipperId == request.auth.uid
        && isVnpayOrder(resource.data)
        && resource.data.paymentStatus == "PAID"
        && resource.data.status == "DELIVERING"
        && resource.data.get("deliveryHandoffStatus", "LOCKED") == "CUSTOMER_CONFIRMED"
        && request.resource.data.status == "DELIVERED"
        && request.resource.data.deliveryHandoffStatus == "COMPLETED"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deliveryCompletedAt == request.time
        && request.resource.data.deliveredAt == request.time
        && validStatusHistoryField();
    }

    function shipperOwnsOrClaimsOrder() {
      return (
        resource.data.status in ["READY", "READY_FOR_DELIVERY", "ASSIGNED_TO_SHIPPER"]
        && resource.data.get("shipperId", "") == ""
        && request.resource.data.shipperId == request.auth.uid
      )
        || (
          resource.data.status in ["ASSIGNED_TO_SHIPPER", "DELIVERING"]
          && resource.data.get("shipperId", "") == request.auth.uid
          && request.resource.data.get("shipperId", "") == request.auth.uid
        );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow update: if isAdmin() || validProductRatingUpdate();
      allow create, delete: if isAdmin();
    }

    match /productReviews/{reviewId} {
      allow read: if true;
      allow create, update: if validProductReviewWrite(reviewId);
      allow delete: if isAdmin() || (isCustomer() && resource.data.customerId == request.auth.uid);
    }

    match /promoCodes/{promoCodeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /appConfig/{configId} {
      allow get, list: if isActiveUser() && configId == "store";
      allow create, update, delete: if isAdmin() && configId == "store";
    }

    match /users/{userId} {
      match /devices/{deviceId} {
        allow get, list: if isOwner(userId) && isActiveUser();
        allow create, update: if isOwner(userId)
          && isActiveUser()
          && request.resource.data.keys().hasOnly([
            "fcmToken",
            "appEdition",
            "applicationId",
            "role",
            "installationId",
            "notificationsEnabled",
            "updatedAt"
          ])
          && request.resource.data.fcmToken is string
          && request.resource.data.appEdition is string
          && request.resource.data.applicationId is string
          && request.resource.data.role is string
          && request.resource.data.installationId == deviceId
          && request.resource.data.notificationsEnabled is bool;
        allow delete: if isOwner(userId) && isActiveUser();
      }

      allow get: if (isOwner(userId) && isActiveUser()) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || validCustomerProfileCreate(userId);
      allow update: if isAdmin()
        || (isOwner(userId) && isActiveUser() && protectedUserFieldsUnchanged());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrderCreate(orderId);
      allow get: if canGetOrder(orderId);
      allow list: if isAdmin()
        || isStaff()
        || isKitchen()
        || isShipper()
        || (isCustomer() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin()
        || (isCustomer() && orderStatusOnlyUpdate() && validStatusHistoryField() && customerCancelTransition())
        || (customerReceiptTransition() && paymentFieldsProtected())
        || (
          isStaff()
          && orderStatusOnlyUpdate()
          && validStatusHistoryField()
          && paymentFieldsProtected()
          && (staffStatusTransition() || staffCancelTransition())
        )
        || (
          isKitchen()
          && kitchenStatusUpdate()
          && validStatusHistoryField()
          && kitchenProgressFieldsValid()
          && paymentFieldsProtected()
          && kitchenStatusTransition()
        )
        || (
          isShipper()
          && shipperStatusUpdate()
          && shipperOwnsOrClaimsOrder()
          && shipperPaymentCollectionFieldsValid()
          && validStatusHistoryField()
          && paymentFieldsProtected()
          && (!isVnpayOrder(resource.data) || resource.data.paymentStatus == "PAID")
          && shipperStatusTransition()
        )
        || (shipperArrivalTransition() && paymentFieldsProtected())
        || (shipperPrepaidCompletionTransition() && paymentFieldsProtected());
      allow delete: if isAdmin();

      match /tracking/current {
        allow get: if canReadCurrentTracking(orderId);
        allow create, update: if canWriteCurrentTracking(orderId);
        allow list, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
